rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow anyone to sign up for the mailing list, but not read or delete existing emails.
    match /mailing-list/{email} {
      allow read, update, delete: if false;
      allow create: if true;
    }

    // Allow anyone to read the access codes for the ranking.
    // Allow only increasing usedCount; no other fields may change.
    // Permit one-time conversion from string -> int for legacy docs.
    match /access-codes/{code} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["usedCount"]) && (
          // If both are integers, enforce non-decreasing
          (resource.data.usedCount is int && request.resource.data.usedCount is int &&
           request.resource.data.usedCount >= resource.data.usedCount) ||
          // If legacy value was a string, allow converting to an integer (any non-negative)
          (resource.data.usedCount is string && request.resource.data.usedCount is int &&
           request.resource.data.usedCount >= 0) ||
          // If field didn't exist, allow initializing to a positive integer
          (resource.data.usedCount == null && request.resource.data.usedCount is int &&
           request.resource.data.usedCount >= 1)
        );
    }
  }
}
